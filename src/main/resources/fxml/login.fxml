<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.onecritto.home.ui.LoginController"
      alignment="CENTER"
      fx:id="rootContainer"
      spacing="15">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <ImageView fitHeight="65" preserveRatio="true">
        <image>
            <Image url="@/icons/logo.png"/>
        </image>
    </ImageView>

    <Label wrapText="true"
           maxWidth="400"
           textAlignment="CENTER"
           style="-fx-font-size: 12; -fx-text-fill: #444;">
        <text>
            Inserisci la tua Master Password.
            Se è il primo avvio, digita una nuova password e premi "Crea nuovo vault".
            Altrimenti digita la password e premi "Apri vault".
            La Master Password non può essere recuperata.
        </text>
    </Label>

    <HBox spacing="5" alignment="CENTER" minWidth="555" >

        <PasswordField fx:id="masterPasswordField"  HBox.hgrow="ALWAYS" promptText="Master password"   prefWidth="180"     minWidth="180"  style="-fx-font-size: 14px;"/>
        <TextField fx:id="secretVisibleField" HBox.hgrow="ALWAYS" promptText="Master password" visible="false" managed="false" style="-fx-font-size: 14px;"/>

        <Button   onAction="#handleOpenPasswordGenerator">
            <graphic>
                <FontAwesomeIconView  glyphName="MAGIC" glyphSize="16"/>
            </graphic>
        </Button>

        <Button fx:id="toggleSecretButton" onAction="#handleToggleSecret">
            <graphic>
                <FontAwesomeIconView fx:id="toggleIcon" glyphName="EYE" glyphSize="16"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Meter forza password -->
    <VBox spacing="4" prefWidth="320" alignment="CENTER">
        <ProgressBar fx:id="passwordStrengthBar"
                     prefWidth="280"
                     progress="0.0"  HBox.hgrow="ALWAYS" />

        <Label fx:id="passwordStrengthLabel"
               text="Forza password: vuota"
               style="-fx-font-size: 11; -fx-text-fill: #444; " HBox.hgrow="ALWAYS"  />
    </VBox>
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="openVaultButton"  text="Apri vault"
                onAction="#handleOpenVault"
                prefWidth="120"/>

        <Button fx:id="createVaultButton"  text="Crea nuovo vault"
                onAction="#handleCreateVault"
                prefWidth="140"/>
    </HBox>
    <VBox alignment="CENTER">
        <ProgressIndicator fx:id="circleProgress" prefWidth="55" prefHeight="55" visible="false" />
    </VBox>
    <Label fx:id="errorLabel"
           textFill="red"
           style="-fx-font-size: 11;"/>
</VBox>
