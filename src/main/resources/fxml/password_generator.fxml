<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safebox.home.ui.PasswordGeneratorController">

    <content>
        <VBox spacing="18" style="-fx-padding: 16;">

            <Label text="Generatore Password"
                   style="-fx-font-size: 20; -fx-font-weight: bold;"/>

            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

                <!-- TAB PASSWORD FORTE -->
                <Tab text="Password Forte">
                    <content>
                        <VBox spacing="14" style="-fx-padding: 16;">

                            <HBox spacing="10">
                                <TextField fx:id="generatedPasswordField"
                                           promptText="Password generata"
                                           editable="false"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-font-size: 16;"/>
                                <Button fx:id="copyButton"
                                        onAction="#handleCopy">
                                    <graphic>
                                        <FontAwesomeIconView glyphName="CLIPBOARD" glyphSize="18"/>
                                    </graphic>
                                </Button>
                            </HBox>

                            <!-- PROGRESS BAR STRENGTH -->
                            <VBox spacing="4">
                                <Label fx:id="strengthLabel" text="Forza password: -"
                                       style="-fx-font-weight: bold;"/>
                                <ProgressBar fx:id="strengthBar" prefWidth="260"/>
                            </VBox>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Lunghezza:"/>
                                <Slider fx:id="lengthSlider"
                                        min="8" max="40" value="16"
                                        majorTickUnit="4"
                                        showTickMarks="true"/>
                                <Label fx:id="lengthLabel" text="16"
                                       style="-fx-font-weight: bold;"/>
                            </HBox>

                            <VBox spacing="6">
                                <Label text="Caratteri consentiti:" style="-fx-font-weight: bold;"/>

                                <HBox spacing="20">
                                    <CheckBox fx:id="includeUpper" text="Lettere maiuscole" selected="true"/>
                                    <CheckBox fx:id="includeLower" text="Lettere minuscole" selected="true"/>
                                </HBox>

                                <HBox spacing="20">
                                    <CheckBox fx:id="includeDigits" text="Numeri" selected="true"/>
                                    <CheckBox fx:id="includeSymbols" text="Simboli" selected="true"/>
                                </HBox>

                                <CheckBox fx:id="avoidAmbiguous"
                                          text="Evita caratteri ambigui"/>
                            </VBox>

                            <Button fx:id="generateButton"
                                    text="Genera password forte"
                                    maxWidth="Infinity"
                                    onAction="#handleGenerate"
                                    style="-fx-padding: 8; -fx-font-size: 14;"/>
                        </VBox>
                    </content>
                </Tab>


                <!-- TAB PASSWORD MNEMONICA -->
                <Tab text="Password Mnemonica">
                    <content>
                        <VBox spacing="14" style="-fx-padding: 16;">

                            <TextArea fx:id="mnemonicOutput"
                                      editable="false"
                                      wrapText="true"
                                      style="-fx-font-size: 16;"
                                      prefRowCount="3"/>

                            <!-- PROGRESS BAR MNEMONICA -->
                            <VBox spacing="4">
                                <Label fx:id="mnemonicStrengthLabel" text="Forza password: -"
                                       style="-fx-font-weight: bold;"/>
                                <ProgressBar fx:id="mnemonicStrengthBar" prefWidth="260"/>
                            </VBox>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Sillabe:"/>
                                <Slider fx:id="mnemonicSyllablesSlider"
                                        min="4" max="12" value="6"
                                        majorTickUnit="1"
                                        showTickMarks="true"
                                        showTickLabels="true"
                                        prefWidth="200"/>
                                <Label fx:id="mnemonicSyllablesLabel" text="6"/>
                            </HBox>

                            <CheckBox fx:id="mnemonicIncludeDigits"
                                      text="Aggiungi numero finale"/>

                            <Button fx:id="generateMnemonicButton"
                                    text="Genera password mnemonica"
                                    maxWidth="Infinity"
                                    onAction="#handleGenerateMnemonic"
                                    style="-fx-padding: 8; -fx-font-size: 14;"/>

                        </VBox>
                    </content>
                </Tab>

            </TabPane>

        </VBox>
    </content>



</DialogPane>
