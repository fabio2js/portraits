<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<DialogPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safebox.home.ui.PasswordGeneratorController"
            prefWidth="420">

    <content>
        <VBox spacing="12">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Generatore password forte"
                   style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <!-- Password generata -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="generatedField" prefWidth="270"/>
                <Button fx:id="copyButton">
                    <graphic>
                        <FontAwesomeIconView glyphName="CLIPBOARD" glyphSize="16"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Barra qualità -->
            <ProgressBar fx:id="strengthBar" prefWidth="300"/>
            <Label fx:id="strengthLabel" text="Qualità: " style="-fx-font-style: italic;"/>

            <!-- Lunghezza -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Lunghezza:"/>
                <Slider fx:id="lengthSlider" min="6" max="64" value="16" prefWidth="220"/>
                <Label fx:id="lengthValue" text="16"/>
            </HBox>

            <!-- Charset -->
            <VBox spacing="6">
                <Label text="Caratteri consentiti:"/>
                <HBox spacing="20">
                    <CheckBox fx:id="lowerCB" text="minuscole (a-z)" selected="true"/>
                    <CheckBox fx:id="upperCB" text="maiuscole (A-Z)" selected="true"/>
                </HBox>

                <HBox spacing="20">
                    <CheckBox fx:id="digitsCB" text="numeri (0-9)" selected="true"/>
                    <CheckBox fx:id="symbolsCB" text="simboli (!@#$...)" selected="true"/>
                </HBox>
            </VBox>

            <!-- Regole -->
            <VBox spacing="6">
                <Label text="Regole aggiuntive:"/>
                <CheckBox fx:id="reqUpper" text="deve contenere almeno una maiuscola"/>
                <CheckBox fx:id="reqDigit" text="deve contenere almeno un numero"/>
                <CheckBox fx:id="reqSymbol" text="deve contenere almeno un simbolo"/>
            </VBox>

            <Button text="Genera nuova password" fx:id="generateButton"
                    maxWidth="Infinity" style="-fx-padding: 10; -fx-font-size: 14;"/>

        </VBox>
    </content>
</DialogPane>
